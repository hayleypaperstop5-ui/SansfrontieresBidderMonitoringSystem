{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Player Coverage | Sansfrontieres</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f5f7fa;
            color: #212529;
        }

        header {
            background: #212529;
            color: white;
            padding: 18px 32px;
        }

        header h1 {
            margin: 0;
            font-size: 22px;
        }

        main {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-header {
            margin-bottom: 24px;
        }

        .page-header h1 {
            margin-bottom: 8px;
        }

        .page-header p {
            color: #6c757d;
        }

        .card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            margin-bottom: 24px;
            overflow: hidden;
        }

        .card-header {
            padding: 18px 22px;
            border-bottom: 1px solid #dee2e6;
        }

        .card-header h2 {
            margin: 0;
            font-size: 20px;
        }

        .card-body {
            padding: 22px;
        }

        .card-body p {
            margin: 0 0 12px;
        }

        .alert {
            padding: 14px 16px;
            border-radius: 7px;
            margin: 18px 0;
        }

        .alert-success {
            background: #d1e7dd;
            color: #0f5132;
        }

        .alert-error {
            background: #f8d7da;
            color: #842029;
        }

        .alert-warning {
            background: #fff3cd;
            color: #664d03;
        }

        .alert-info {
            background: #cff4fc;
            color: #055160;
        }

        .button {
            display: inline-block;
            padding: 11px 18px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-size: 15px;
            margin-right: 8px;
        }

        .button-primary {
            background: #0d6efd;
            color: white;
        }

        .button-secondary {
            background: #6c757d;
            color: white;
        }

        form {
            display: inline-block;
            margin-bottom: 12px;
        }
    </style>
<style>
.sf-signin-countdown {
    margin: 15px 0;
    padding: 16px 20px;
    border-radius: 8px;
    border: 1px solid #f0ad4e;
    background: #fff8e8;
}

.sf-signin-countdown-label {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 5px;
}

.sf-signin-countdown-time {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 1px;
}

.sf-signin-deadline {
    margin-top: 6px;
    font-size: 13px;
}

.sf-signin-countdown.is-urgent {
    border-color: #dc3545;
}

.sf-signin-countdown.is-expired {
    border-color: #dc3545;
    background: #fff0f0;
}

.sf-missed-banner {
    margin: 15px 0;
    padding: 18px 20px;
    border-radius: 8px;
    border: 1px solid #dc3545;
    background: #fff0f0;
}

.sf-missed-banner strong {
    display: block;
    margin-bottom: 6px;
    font-size: 18px;
}
</style>
</head>

<body>

<header>
    <h1>Sansfrontieres</h1>
</header>

<main>

    <div class="page-header">
        <h1>My Player Coverage</h1>
        <p>View your assigned Player coverage and report for your session.</p>
    </div>

    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endif %}

    {% if active_session %}

        <section class="card">
            <div class="card-header">
                <h2>Active Coverage</h2>
            </div>

            <div class="card-body">
                <p>
                    <strong>Player:</strong>
                    {{ active_session.player }}
                </p>

                <p>
                    <strong>Session:</strong>
                    {{ active_session.get_session_type_display }}
                </p>

                <p>
                    <strong>Operating Date:</strong>
                    {{ active_session.operating_date|date:"d M Y" }}
                </p>

                <p>
                    <strong>Signed In:</strong>
                    {{ active_session.signed_in_at|date:"d M Y, H:i" }}
                </p>

                <p>
                    <strong>Scheduled Closure:</strong>
                    {{ active_session.scheduled_close_at|date:"d M Y, H:i" }}
                </p>

                <p>
                    <strong>Status:</strong>
                    {{ active_session.get_status_display }}
                </p>

                <div class="alert alert-info">
                    You are currently covering this Player. Continue working until
                    your replacement has been secured or the Manager provides an
                    authorised override.
                </div>
<form method="post">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="request_replacement">

                    <button type="submit" class="button button-primary">
                        Request Replacement
                    </button>
                </form>

                <a href="{% url 'dashboard:home' %}" class="button button-secondary">
                    Back to Dashboard
                </a>
            </div>
        </section>

    {% elif awaiting_report_session %}

        <section class="card">
            <div class="card-header">
                <h2>Replacement Completed</h2>
            </div>

            <div class="card-body">
                <p>
                    <strong>Player:</strong>
                    {{ awaiting_report_session.player }}
                </p>

                <p>
                    <strong>Session:</strong>
                    {{ awaiting_report_session.get_session_type_display }}
                </p>

                <p>
                    <strong>Operating Date:</strong>
                    {{ awaiting_report_session.operating_date|date:"d M Y" }}
                </p>

                <p>
                    <strong>Signed In:</strong>
                    {{ awaiting_report_session.signed_in_at|date:"d M Y, H:i" }}
                </p>

                {% if awaiting_report_session.replacement_moderator %}
                    <p>
                        <strong>Replacement Moderator:</strong>
                        {{ awaiting_report_session.replacement_moderator.get_full_name|default:awaiting_report_session.replacement_moderator.username }}
                    </p>
                {% endif %}

                {% if not awaiting_report_session.signed_out_at %}

                    <div class="alert alert-success">
                        <strong>Your replacement has been assigned successfully.</strong>
                        You may now sign out of this Player coverage session.
                        After signing out, you must submit your
                        End-of-Session Report.
                    </div>

                    <form method="post">
                        {% csrf_token %}
                        <input type="hidden" name="action" value="sign_out">
                        <input
                            type="hidden"
                            name="session_id"
                            value="{{ awaiting_report_session.id }}"
                        >

                        <button
                            type="submit"
                            class="button button-primary"
                            onclick="return confirm('Confirm that you have handed over this Player and want to sign out?');"
                        >
                            Sign Out of Coverage
                        </button>
                    </form>

                {% else %}

                    <div class="alert alert-warning">
                        You have signed out of this coverage session.
                        Your End-of-Session Report is now required.
                    </div>

                    <a
                        href="{% url 'coverage:end_of_session_report' awaiting_report_session.id %}"
                        class="button button-primary"
                    >
                        Submit End-of-Session Report
                    </a>

                {% endif %}

                <a
                    href="{% url 'dashboard:home' %}"
                    class="button button-secondary"
                >
                    Back to Dashboard
                </a>
            </div>
        </section>

    {% elif assigned_session %}

        <section class="card">
            <div class="card-header">
                <h2>Assigned Coverage</h2>
            </div>

            <div class="card-body">
                <p>
                    <strong>Player:</strong>
                    {{ assigned_session.player }}
                </p>

                <p>
                    <strong>Session:</strong>
                    {{ assigned_session.get_session_type_display }}
                </p>

                <p>
                    <strong>Operating Date:</strong>
                    {{ assigned_session.operating_date|date:"d M Y" }}
                </p>

                <p>
                    <strong>Scheduled Closure:</strong>
                    {{ assigned_session.scheduled_close_at|date:"d M Y, H:i" }}
                </p>

                <div class="alert alert-warning">
                    You have been assigned to this Player. Please sign in before
                    beginning your moderation session.
                </div>
                <div
    id="sf-signin-countdown"
    class="sf-signin-countdown"
    data-deadline="{{ assigned_session.sign_in_deadline_at|date:'c' }}"
>
    <div class="sf-signin-countdown-label">
        Sign-in required within:
    </div>

    <div
        id="sf-signin-countdown-time"
        class="sf-signin-countdown-time"
    >
        Calculating...
    </div>

    <div class="sf-signin-deadline">
        Sign-in deadline:
        <strong>
            {{ assigned_session.sign_in_deadline_at|date:"h:i A" }}
        </strong>
    </div>
</div>

                <form method="post">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="sign_in">

                    <button type="submit" class="button button-primary">
                        Sign In to Coverage
                    </button>
                </form>

                <a href="{% url 'dashboard:home' %}" class="button button-secondary">
                    Back to Dashboard
                </a>
            </div>
        </section>

    {% elif expired_session %}

        <section class="card">
            <div class="card-header">
                <h2>Coverage Assignment Missed</h2>
            </div>

            <div class="card-body">
                <p>
                    <strong>Player:</strong>
                    {{ expired_session.player }}
                </p>

                <p>
                    <strong>Session:</strong>
                    {{ expired_session.get_session_type_display }}
                </p>

                <p>
                    <strong>Operating Date:</strong>
                    {{ expired_session.operating_date|date:"d M Y" }}
                </p>

                <p>
                    <strong>Scheduled Closure:</strong>
                    {{ expired_session.scheduled_close_at|date:"d M Y, H:i" }}
                </p>

                <div class="alert alert-warning">
                    The 15-minute sign-in window for this assignment has expired.
                    This coverage session has been marked as MISSED and is no longer
                    available for sign-in.
                </div>

                <p>
                    The Manager should arrange replacement coverage so the Player
                    is not left uncovered.
                </p>

                <a href="{% url 'dashboard:home' %}" class="button button-primary">
                    Back to Dashboard
                </a>
            </div>
        </section>

    {% else %}

        <section class="card">
            <div class="card-header">
                <h2>No Active Coverage Assignment</h2>
            </div>

            <div class="card-body">
                <p>
                    You currently have no Player coverage assignment awaiting
                    sign-in or active coverage session.
                </p>

                <p>
                    Please contact the Manager if you believe you should have
                    an assignment.
                </p>

                <a href="{% url 'dashboard:home' %}" class="button button-secondary">
                    Back to Dashboard
                </a>
            </div>
        </section>

    {% endif %}

</main>

<script>
(function () {
    if (window.sfCountdownInitialized) {
        return;
    }

    window.sfCountdownInitialized = true;

    const box = document.getElementById("sf-signin-countdown");
    const display = document.getElementById("sf-signin-countdown-time");

    if (!box || !display) {
        return;
    }

    const rawDeadline = box.dataset.deadline;

    if (!rawDeadline) {
        display.textContent = "Deadline unavailable";
        return;
    }

    const deadline = new Date(rawDeadline).getTime();

    if (Number.isNaN(deadline)) {
        display.textContent = "Deadline unavailable";
        return;
    }

    function updateCountdown() {
        const remaining = deadline - Date.now();

        if (remaining <= 0) {
            display.textContent = "00:00";
            box.classList.add("is-expired");

            const label = box.querySelector(
                ".sf-signin-countdown-label"
            );

            if (label) {
                label.textContent = "Sign-in window expired";
            }

            return;
        }

        const totalSeconds = Math.floor(remaining / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;

        display.textContent =
            String(minutes).padStart(2, "0") +
            ":" +
            String(seconds).padStart(2, "0");

        if (remaining <= 5 * 60 * 1000) {
            box.classList.add("is-urgent");
        }

        window.setTimeout(updateCountdown, 1000);
    }

    updateCountdown();
})();
</script>
</body>
</html>


<script src="{% static 'js/notification_alerts.js' %}"></script>



