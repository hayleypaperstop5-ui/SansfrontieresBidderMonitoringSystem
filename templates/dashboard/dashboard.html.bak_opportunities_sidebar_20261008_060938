                    <div style="background:#fff; border:1px solid #e5e7eb; border-radius:1rem; overflow:hidden; ">

                        {% if manager_reports %}

                            <div style="    ">
                                <table style="width:100%; table-layout:fixed; border-collapse:collapse;">
                                    <thead>
                                        <tr style="border-bottom:1px solid #e5e7eb;">
                                            <th style="padding:.75rem .65rem; text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;">
                                                Session ID
                                            </th>
                                            <th style="padding:.75rem .65rem; text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;">
                                                Date
                                            </th>
                                            <th style="padding:.75rem .65rem; text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;">
                                                Player
                                            </th>
                                            <th style="padding:.75rem .65rem; text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;">
                                                Moderator
                                            </th>
                                            <th style="padding:.75rem .65rem; text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;">
                                                Chats
                                            </th>
                                            <th style="padding:.75rem .65rem; text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;">
                                                Account Rating
                                            </th>
                                            <th style="padding:.75rem .65rem; text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em;">
                                                Evidence
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        {% for session in manager_reports %}
                                            <tr style="border-bottom:1px solid #f1f5f9;">
                                                <td style="padding:.75rem .65rem; font-weight:600; overflow-wrap:anywhere;">
                                                    {{ session.session_code }}
                                                </td>
                                                <td style="padding:.75rem .65rem; overflow-wrap:anywhere;">
                                                    {{ session.operating_date|date:"d M Y" }}
                                                </td>

                                                <td style="padding:.75rem .65rem; font-weight:600; overflow-wrap:anywhere;">
                                                    {{ session.player }}
                                                </td>

                                                <td style="padding:.75rem .65rem; overflow-wrap:anywhere;">
                                                    {{ session.moderator.get_full_name|default:"Unknown" }}
                                                </td>

                                                <td style="padding:.75rem .65rem; overflow-wrap:anywhere;">
                                                    {{ session.end_of_session_report.chats_responded }}
                                                </td>

                                                <td style="padding:.75rem .65rem; overflow-wrap:anywhere;">
                                                    {{ session.end_of_session_report.account_rating }}
                                                </td>

                                                <td style="padding:.75rem .65rem; overflow-wrap:anywhere;">
                                                    {% if session.end_of_session_report.screenshot %}
                                                        <a
                                                            href="{% url 'coverage:download_report_evidence' session.end_of_session_report.id %}"
                                                            style="display:inline-flex; align-items:center; padding:.55rem .85rem; border-radius:.65rem; background:#eef2ff; color:#3730a3; font-size:.8rem; font-weight:700; text-decoration:none;"
                                                        >
                                                            Download Evidence
                                                        </a>
                                                    {% else %}
                                                        <span style="font-size:.8rem; color:#94a3b8;">
                                                            No evidence attached
                                                        </span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                        {% else %}

                            <div style="padding:2rem; text-align:center; color:#64748b;">
                                No completed End-of-Session Reports are available yet.
                            </div>

                        {% endif %}

                    </div>

                </section>

                </div>

            </div>

        </div>

    </main>

</div>
