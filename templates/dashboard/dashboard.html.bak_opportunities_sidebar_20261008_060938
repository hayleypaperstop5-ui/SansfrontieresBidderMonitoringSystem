<style>
/* SANSFRONTIERES MANAGER DASHBOARD v2 */

.manager-dashboard {
    --manager-bg: #f4f7fb;
    --manager-surface: #ffffff;
    --manager-text: #172033;
    --manager-muted: #64748b;
    --manager-border: #e5e7eb;

    --staff: #2563eb;
    --staff-dark: #1d4ed8;
    --staff-soft: #eff6ff;

    --players: #7c3aed;
    --players-dark: #6d28d9;
    --players-soft: #f5f3ff;

    --coverage: #059669;
    --coverage-dark: #047857;
    --coverage-soft: #ecfdf5;
}

.manager-dashboard {
    background:
        radial-gradient(circle at top right, rgba(37, 99, 235, .06), transparent 30%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, .05), transparent 28%);
}

.manager-dashboard .manager-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 30px;
    padding: 28px 30px;
    border-radius: 18px;
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid var(--manager-border);
    box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
}

.manager-dashboard .manager-hero h1 {
    margin: 0 0 8px;
    color: var(--manager-text);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    letter-spacing: -.8px;
}

.manager-dashboard .manager-hero p {
    margin: 0;
    color: var(--manager-muted);
    font-size: 15px;
    line-height: 1.6;
}

.manager-dashboard .manager-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border-radius: 999px;
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
}

.manager-dashboard .manager-hero-badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, .12);
}

.manager-dashboard .manager-notification {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 16px;
    border-radius: 10px;
    background: #172033;
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
}

.manager-dashboard .manager-notification:hover {
    background: #0f172a;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(15, 23, 42, .16);
}

.manager-dashboard .management-heading {
    margin: 0 0 6px;
    color: var(--manager-text);
    font-size: 21px;
    font-weight: 800;
}

.manager-dashboard .management-subheading {
    margin: 0 0 20px;
    color: var(--manager-muted);
    font-size: 14px;
    line-height: 1.6;
}

.manager-dashboard .management-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.manager-dashboard .management-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 265px;
    padding: 25px;
    overflow: hidden;
    background: var(--manager-surface);
    border: 1px solid var(--manager-border);
    border-radius: 18px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.manager-dashboard .management-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
}

.manager-dashboard .management-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(15, 23, 42, .11);
}

.manager-dashboard .staff-card::before {
    background: var(--staff);
}

.manager-dashboard .player-card::before {
    background: var(--players);
}

.manager-dashboard .coverage-card-new::before {
    background: var(--coverage);
}

.manager-dashboard .management-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin-bottom: 19px;
    border-radius: 14px;
    font-size: 24px;
}

.manager-dashboard .staff-card .management-icon {
    background: var(--staff-soft);
    color: var(--staff-dark);
}

.manager-dashboard .player-card .management-icon {
    background: var(--players-soft);
    color: var(--players-dark);
}

.manager-dashboard .coverage-card-new .management-icon {
    background: var(--coverage-soft);
    color: var(--coverage-dark);
}

.manager-dashboard .management-card h3 {
    margin: 0 0 9px;
    color: var(--manager-text);
    font-size: 19px;
    font-weight: 800;
}

.manager-dashboard .management-card p {
    margin: 0;
    color: var(--manager-muted);
    font-size: 14px;
    line-height: 1.65;
}

.manager-dashboard .management-card .management-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 7px;
    margin-top: auto;
    padding: 10px 15px;
    border-radius: 9px;
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    transition: transform .18s ease, filter .18s ease;
}

.manager-dashboard .staff-card .management-link {
    background: var(--staff);
}

.manager-dashboard .player-card .management-link {
    background: var(--players);
}

.manager-dashboard .coverage-card-new .management-link {
