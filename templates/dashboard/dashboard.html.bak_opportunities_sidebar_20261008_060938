﻿﻿﻿﻿﻿﻿﻿﻿﻿{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sansfrontieres | Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --green-900: #123b2a;
            --green-800: #14532d;
            --green-700: #166534;
            --green-100: #dcfce7;
            --slate-900: #0f172a;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-500: #64748b;
            --slate-300: #cbd5e1;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --page: #f6f8f7;
            --white: #ffffff;
            --amber-700: #b45309;
            --amber-100: #fef3c7;
            --red-700: #b91c1c;
            --red-100: #fee2e2;
            --blue-700: #1d4ed8;
            --blue-100: #dbeafe;
        }

        body {
            margin: 0;
            font-family: Inter, Arial, Helvetica, sans-serif;
            background: var(--page);
            color: var(--slate-900);
        }

        a {
            color: inherit;
        }

        .topbar {
            min-height: 68px;
            background: var(--green-900);
            color: white;
            padding: 0 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: -.3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .top-link {
            color: #ecfdf5;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
        }

        .top-link:hover {
            text-decoration: underline;
        }

        .layout {
            display: flex;
            min-height: calc(100vh - 68px);
        }

        .sidebar {
            width: 238px;
            background: #0f2f23;
            padding: 26px 15px;
            flex-shrink: 0;
        }

        .portal-label {
            color: #a7f3d0;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            margin: 0 13px 16px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #dbe7e1;
            text-decoration: none;
            padding: 12px 14px;
            border-radius: 9px;
            margin-bottom: 5px;
            font-size: 14px;
            font-weight: 700;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #174936;
            color: white;
        }

        .nav-icon {
            width: 22px;
            text-align: center;
            font-size: 15px;
        }

        .sidebar-bottom {
            margin-top: 32px;
            padding-top: 18px;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .logout {
            color: #fecaca;
        }

        .main {
            flex: 1;
            min-width: 0;
            padding: 32px;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
        }

        .hero {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 25px;
        }

        .hero h1 {
            margin: 0 0 7px;
            color: var(--green-900);
            font-size: 31px;
            line-height: 1.15;
            letter-spacing: -.7px;
        }

        .hero p {
            margin: 0;
            color: var(--slate-500);
            font-size: 15px;
        }

        .hero-date {
            color: var(--slate-500);
            font-size: 13px;
            font-weight: 700;
        }

        .section {
            margin-top: 25px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 13px;
        }

        .section-heading h2 {
            margin: 0;
            color: var(--slate-900);
            font-size: 18px;
            letter-spacing: -.2px;
        }

        .section-heading a {
            color: var(--green-700);
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
        }

        .section-heading a:hover {
            text-decoration: underline;
        }

        .section-heading a.button-primary {
            color: white;
        }

        .section-heading a.button-primary:hover {
            color: white;
            text-decoration: none;
        }

        .next-action {
            border-radius: 15px;
            padding: 21px 23px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border: 1px solid var(--green-100);
            background: var(--white);
            box-shadow: 0 5px 18px rgba(15, 47, 35, .06);
        }

        .next-action.warning {
            border-color: #fde68a;
            background: #fffbeb;
        }

        .next-action.success {
            border-color: var(--green-100);
            background: #f0fdf4;
        }

        .next-label {
            color: var(--green-700);
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .next-action h3 {
            margin: 0 0 5px;
            color: var(--slate-900);
            font-size: 19px;
        }

        .next-action p {
            margin: 0;
            color: var(--slate-600);
            font-size: 14px;
            line-height: 1.5;
        }

        .coverage-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 6px 22px rgba(15, 23, 42, .055);
        }

        .coverage-card.live {
            border-color: #86efac;
            box-shadow: 0 8px 25px rgba(22, 101, 52, .09);
        }

        .coverage-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 18px;
            margin-bottom: 22px;
        }

        .coverage-kicker {
            color: var(--green-700);
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 7px;
        }

        .coverage-title {
            margin: 0;
            color: var(--slate-900);
            font-size: 23px;
        }

        .coverage-subtitle {
            margin: 5px 0 0;
            color: var(--slate-500);
            font-size: 14px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            padding: 7px 11px;
            font-size: 11px;
            font-weight: 900;
            white-space: nowrap;
        }

        .status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .status-success {
            background: var(--green-100);
            color: var(--green-700);
        }

        .status-warning {
            background: var(--amber-100);
            color: var(--amber-700);
        }

        .status-danger {
            background: var(--red-100);
            color: var(--red-700);
        }

        .status-info {
            background: var(--blue-100);
            color: var(--blue-700);
        }

        .coverage-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .coverage-item {
            background: var(--slate-100);
            border-radius: 10px;
            padding: 14px;
        }

        .coverage-item span {
            display: block;
            color: var(--slate-500);
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 6px;
        }

        .coverage-item strong {
            color: var(--slate-900);
            font-size: 15px;
        }

        .coverage-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 20px;
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 10px 15px;
            border-radius: 9px;
            border: none;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
        }

        .button-primary {
            background: var(--green-700);
            color: white;
        }

        .button-primary:hover {
            background: var(--green-800);
        }

        .button-secondary {
            background: var(--slate-100);
            color: var(--slate-700);
        }

        .button-secondary:hover {
            background: var(--slate-200);
        }

        .button-warning {
            background: #d97706;
            color: white;
        }

        .button-warning:hover {
            background: #b45309;
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
        }

        .metric-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: 13px;
            padding: 17px;
            min-width: 0;
            box-shadow: 0 3px 13px rgba(15, 23, 42, .035);
        }

        .metric-label {
            color: var(--slate-500);
            font-size: 10px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .65px;
        }

        .metric-value {
            margin-top: 8px;
            color: var(--green-900);
            font-size: 25px;
            line-height: 1.1;
            font-weight: 900;
        }

        .metric-card.money .metric-value {
            font-size: 21px;
        }

        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .panel {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: 14px;
            padding: 21px;
            box-shadow: 0 3px 13px rgba(15, 23, 42, .035);
        }

        .panel h3 {
            margin: 0 0 16px;
            color: var(--slate-900);
            font-size: 17px;
        }

        .panel-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 12px 0;
            border-bottom: 1px solid var(--slate-100);
        }

        .panel-row:last-child {
            border-bottom: none;
        }

        .panel-row span {
            color: var(--slate-500);
            font-size: 13px;
        }

        .panel-row strong {
            color: var(--slate-900);
            font-size: 14px;
        }

        .status-number {
            min-width: 28px;
            height: 28px;
            padding: 0 8px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--slate-100);
            color: var(--slate-700);
            font-weight: 900;
        }

        .status-number.alert {
            background: var(--amber-100);
            color: var(--amber-700);
        }

        .status-number.danger {
            background: var(--red-100);
            color: var(--red-700);
        }

        .earnings-total {
            margin: 0 0 16px;
            padding: 17px;
            border-radius: 11px;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        .earnings-total span {
            display: block;
            color: var(--green-700);
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .7px;
        }

        .earnings-total strong {
            display: block;
            margin-top: 4px;
            color: var(--green-900);
            font-size: 28px;
        }

        .activity-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .activity-item {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 15px;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid var(--slate-100);
        }

        .activity-item:last-child {
            border-bottom: none;
        }

        .activity-player {
            color: var(--slate-900);
            font-size: 14px;
            font-weight: 800;
        }

        .activity-meta {
            color: var(--slate-500);
            font-size: 12px;
            margin-top: 4px;
        }

        .activity-chats {
            color: var(--green-700);
            font-size: 13px;
            font-weight: 900;
            text-align: right;
        }

        .empty-state {
            padding: 25px 18px;
            border: 1px dashed var(--slate-300);
            border-radius: 11px;
            text-align: center;
            color: var(--slate-500);
            background: #fafafa;
        }

        .empty-state strong {
            display: block;
            margin-bottom: 5px;
            color: var(--slate-700);
            font-size: 14px;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
        }

        .quick-action {
            min-height: 74px;
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: 12px;
            padding: 13px;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 5px;
            text-align: center;
            color: var(--slate-700);
            font-size: 12px;
            font-weight: 800;
        }

        .quick-action:hover {
            border-color: #86efac;
            color: var(--green-700);
            transform: translateY(-1px);
        }

        .quick-icon {
            font-size: 19px;
        }

        .non-moderator {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 24px;
        }

        @media (max-width: 1150px) {
            .metrics {
                grid-template-columns: repeat(3, 1fr);
            }

            .quick-actions {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 900px) {
            .sidebar {
                width: 205px;
            }

            .main {
                padding: 24px 20px;
            }

            .coverage-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .two-column {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 680px) {
            .topbar {
                padding: 14px 16px;
            }

            .topbar-right {
                gap: 10px;
            }

            .top-link {
                font-size: 12px;
            }

            .layout {
                display: block;
            }

            .sidebar {
                width: 100%;
                padding: 10px;
            }

            .portal-label {
                margin: 5px 8px 9px;
            }

            .nav-link {
                display: inline-flex;
                width: auto;
                margin: 2px;
                padding: 9px 10px;
                font-size: 12px;
            }

            .nav-icon {
                display: none;
            }

            .sidebar-bottom {
                margin-top: 8px;
                padding-top: 8px;
            }

            .main {
                padding: 20px 14px 30px;
            }

            .hero {
                display: block;
            }

            .hero h1 {
                font-size: 25px;
            }

            .hero-date {
                display: block;
                margin-top: 10px;
            }

            .next-action {
                display: block;
            }

            .next-action .button {
                margin-top: 15px;
                width: 100%;
            }

            .coverage-top {
                display: block;
            }

            .coverage-top .status {
                margin-top: 12px;
            }

            .coverage-grid,
            .metrics,
            .quick-actions {
                grid-template-columns: 1fr 1fr;
            }

            .metric-card {
                padding: 14px;
            }

            .metric-value {
                font-size: 22px;
            }

            .metric-card.money .metric-value {
                font-size: 18px;
            }
        }

        @media (max-width: 430px) {
            .coverage-grid,
            .metrics,
            .quick-actions {
                grid-template-columns: 1fr;
            }

            .activity-item {
                grid-template-columns: 1fr;
            }

            .activity-chats {
                text-align: left;
            }
        }
    </style>
