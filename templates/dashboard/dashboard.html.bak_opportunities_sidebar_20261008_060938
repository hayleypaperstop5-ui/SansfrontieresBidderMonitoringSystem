<body>

{% if request.user.role == "MODERATOR" %}

<header class="topbar">
    <div class="brand">Sansfrontieres</div>

    <div class="topbar-right">
        <a href="{% url 'notifications:list' %}" class="top-link">
            &#128276; Notifications
            {% if unread_notification_count %}
                <span class="badge bg-danger ms-1">
                    {{ unread_notification_count }}
                </span>
            {% endif %}
        </a>

        <a href="{% url 'dashboard:profile' %}" class="top-link">
            {{ request.user.get_full_name|default:request.user.username }}
        </a>
    </div>
</header>

<div class="layout">

    <aside class="sidebar">


        <a href="{% url 'dashboard:home' %}" class="nav-link active">
            <span class="nav-icon">&#127968;</span>
            Dashboard
        </a>

        <a href="{% url 'coverage:moderator_coverage' %}" class="nav-link">
            <span class="nav-icon">&#128197;</span>
            My Coverage
        </a>

        <a href="{% url 'dashboard:coverage_history' %}" class="nav-link">
            <span class="nav-icon">&#128196;</span>
            Reports
        </a>

        <a href="{% url 'payments:history' %}" class="nav-link">
            <span class="nav-icon">&#128176;</span>
            Payments
        </a>

        <a href="{% url 'notifications:list' %}" class="nav-link">
            <span class="nav-icon">&#128276;</span>
            Notifications
            {% if unread_notification_count %}
                <span class="badge bg-danger ms-1">
                    {{ unread_notification_count }}
                </span>
            {% endif %}
        </a>

        <a href="{% url 'dashboard:profile' %}" class="nav-link">
            <span class="nav-icon">&#128100;</span>
            Profile
        </a>

        <div class="sidebar-bottom">
            <a href="{% url 'accounts:logout' %}" class="nav-link logout">
                <span class="nav-icon">&#10140;</span>
                Log out
            </a>
        </div>

    </aside>

    <main class="main">
        <div class="container">

            <section class="hero">
                <div>
                    <h1>
                        Good{% now "H" as current_hour %}{% if current_hour|add:"0" < 12 %} morning{% elif current_hour|add:"0" < 18 %} afternoon{% else %} evening{% endif %}, {{ request.user.first_name|default:request.user.username }}
                    </h1>

                    <p>
                        Here's your moderation activity at a glance.
                    </p>
                </div>

                <div class="hero-date">
                    {% now "l, d M Y" %}
                </div>
            </section>

            <section>
                <div class="next-action {{ next_action.tone }}">

                    <div>
                        <div class="next-label">Next Action</div>

                        <h3>{{ next_action.title }}</h3>

                        <p>{{ next_action.message }}</p>
                    </div>

                    {% if next_action.button_url %}
                        {% if next_action.button_args %}
                            <a
                                href="{% url next_action.button_url next_action.button_args.0 %}"
                                class="button button-primary"
                            >
                                {{ next_action.button_label }}
                            </a>
                        {% else %}
                            <a
                                href="{% url next_action.button_url %}"
                                class="button button-primary"
                            >
                                {{ next_action.button_label }}
                            </a>
                        {% endif %}
                    {% endif %}

                </div>
            </section>

            <section class="section">

                <div class="section-heading">
                    <h2>Current Coverage</h2>
                </div>

                {% if request.user.role == "MODERATOR" %}<div class="mb-3"><a href="{% url 'coverage:opportunities' %}" class="button button-primary">View Available Coverage Opportunities</a></div>{% endif %}
{% if current_session %}

                    <div class="coverage-card live">

                        <div class="coverage-top">

                            <div>
                                <div class="coverage-kicker">
                                    {% if current_session.status == "ACTIVE" %}
                                        Currently Covering
                                    {% elif current_session.status == "OPEN" %}
                                        Assigned Coverage
                                    {% elif current_session.status == "AWAITING_REPORT" %}
                                        Session Complete
                                    {% else %}
                                        Coverage Status
                                    {% endif %}
                                </div>

                                <h2 class="coverage-title">
                                    {% if current_session.player %}
                                        {{ current_session.player }}
                                    {% else %}
                                        Current Coverage
                                    {% endif %}
                                </h2>

                                <p class="coverage-subtitle">
                                    {{ current_session.get_session_type_display }} - {{ current_session.operating_date|date:"d M Y" }}
                                </p>
                            </div>

                            {% if current_session.status == "ACTIVE" %}
                                <span class="status status-success">
                                    Active
                                </span>
                            {% elif current_session.status == "OPEN" %}
                                <span class="status status-warning">
                                    Awaiting Sign-in
                                </span>
                            {% elif current_session.status == "AWAITING_REPORT" %}
                                <span class="status status-warning">
                                    Report Required
                                </span>
                            {% elif current_session.status == "REPLACEMENT_REQUESTED" %}
                                <span class="status status-warning">
                                    Replacement Requested
                                </span>
                            {% else %}
                                <span class="status status-info">
                                    {{ current_session.get_status_display }}
                                </span>
                            {% endif %}

                        </div>

                        <div class="coverage-grid">

                            <div class="coverage-item">
                                <span>Session</span>
                                <strong>
                                    {{ current_session.get_session_type_display }}
                                </strong>
                            </div>

                            <div class="coverage-item">
                                <span>Signed In</span>
                                <strong>
                                    {% if current_session.signed_in_at %}
                                        {{ current_session.signed_in_at|date:"H:i" }}
                                    {% else %}
                                        Not yet
                                    {% endif %}
                                </strong>
                            </div>

                            <div class="coverage-item">
                                <span>Scheduled Close</span>
                                <strong>
                                    {% if current_session.scheduled_close_at %}
                                        {{ current_session.scheduled_close_at|date:"H:i" }}
                                    {% else %}
                                        Not scheduled
                                    {% endif %}
                                </strong>
                            </div>

                            <div class="coverage-item">
                                <span>Chats Responded</span>
                                <strong>
                                    {% if current_session.end_of_session_report %}
                                        {{ current_session.end_of_session_report.chats_responded }}
                                    {% else %}
                                        Not submitted
                                    {% endif %}
                                </strong>
                            </div>

                        </div>

                        <div class="coverage-actions">

                            {% if current_session.status == "OPEN" %}
                                <a
                                    href="{% url 'coverage:moderator_coverage' %}"
                                    class="button button-primary"
                                >
                                    Sign In to Coverage
                                </a>

                            {% elif current_session.status == "AWAITING_REPORT" %}
                                <a
                                    href="{% url 'coverage:end_of_session_report' current_session.id %}"
                                    class="button button-warning"
                                >
                                    Submit End-of-Session Report
                                </a>

                            {% elif current_session.status == "ACTIVE" or current_session.status == "HANDOVER" %}
                                <a
                                    href="{% url 'coverage:moderator_coverage' %}"
                                    class="button button-primary"
                                >
                                    Manage Coverage
                                </a>

                            {% elif current_session.status == "REPLACEMENT_REQUESTED" %}
                                <a
                                    href="{% url 'coverage:moderator_coverage' %}"
                                    class="button button-warning"
                                >
                                    Manage Replacement
                                </a>
                            {% endif %}

                        </div>

                    </div>

                {% else %}

                    <div class="empty-state">
                        <strong>No active Player coverage</strong>
                        You currently have no active coverage assignment.
                        Your next assignment will appear here.
                    </div>

                {% endif %}

            </section>

            <section class="section">

                <div class="section-heading">
                    <h2>Performance</h2>
                </div>

                <div class="metrics">

                    <div class="metric-card">
                        <div class="metric-label">Chats Today</div>
                        <div class="metric-value">{{ chats_today }}</div>
                    </div>

                    <div class="metric-card">
                        <div class="metric-label">Chats This Week</div>
                        <div class="metric-value">{{ chats_this_week }}</div>
                    </div>

                    <div class="metric-card">
                        <div class="metric-label">Unpaid Chats</div>
                        <div class="metric-value">{{ unpaid_chats }}</div>
                    </div>

                    <div class="metric-card">
                        <div class="metric-label">Paid Chats</div>
                        <div class="metric-value">{{ paid_chats }}</div>
                    </div>

                    <div class="metric-card money">
                        <div class="metric-label">Amount Earned</div>
                        <div class="metric-value">
                            KES {{ amount_earned|floatformat:2 }}
                        </div>
                    </div>

                    <div class="metric-card money">
                        <div class="metric-label">Outstanding</div>
                        <div class="metric-value">
                            KES {{ outstanding_amount|floatformat:2 }}
                        </div>
                    </div>

                </div>

                <div class="panel">

                    <h3>Weekly Payroll</h3>

                    {% if moderator_payroll %}
                        {% for payroll in moderator_payroll %}

                            <div class="panel-row">
                                <span>Payroll Week</span>
                                <strong>
                                    {{ payroll.payment_week_start|date:"d M Y" }}
                                    –
                                    {{ payroll.payment_week_end|date:"d M Y" }}
                                </strong>
                            </div>

                            <div class="panel-row">
                                <span>Payable Chats</span>
                                <strong>{{ payroll.payable_chats }}</strong>
                            </div>

                            <div class="panel-row">
                                <span>Earned</span>
                                <strong>KES {{ payroll.earned_amount|floatformat:2 }}</strong>
                            </div>

                            <div class="panel-row">
                                <span>Paid</span>
                                <strong>KES {{ payroll.amount_paid|floatformat:2 }}</strong>
                            </div>

                            <div class="panel-row">
                                <span>Outstanding</span>
                                <strong>KES {{ payroll.outstanding_amount|floatformat:2 }}</strong>
                            </div>

                            <div class="panel-row">
                                <span>Status</span>
                                <strong>{{ payroll.get_status_display }}</strong>
                            </div>

                            {% if not forloop.last %}
                                <hr>
                            {% endif %}

                        {% endfor %}
                    {% else %}
                        <div class="panel-row">
                            <span>Weekly Payroll</span>
                            <strong>No payroll records yet</strong>
                        </div>
                    {% endif %}

                </div>

            </section>

            <section class="section two-column">

                <div class="panel">

                    <h3>Earnings Overview</h3>

                    <div class="earnings-total">
                        <span>Total Payroll Earned</span>
                        <strong>
                            KES {{ total_earnings|floatformat:2 }}
                        </strong>
                    </div>

                    <div class="panel-row">
                        <span>Chat Earnings</span>
                        <strong>
                            KES {{ payroll_chat_earnings|floatformat:2 }}
                        </strong>
                    </div>

                    <div class="panel-row">
                        <span>Bonus Earned</span>
                        <strong>
                            KES {{ payroll_bonus_earned|floatformat:2 }}
                        </strong>
                    </div>

                    <div class="panel-row">
                        <span>Paid</span>
                        <strong>
                            KES {{ payroll_paid|floatformat:2 }}
                        </strong>
                    </div>

                    <div class="panel-row">
                        <span>Outstanding</span>
                        <strong>
                            KES {{ payroll_outstanding|floatformat:2 }}
                        </strong>
                    </div>

                </div>

                <div class="panel">

                    <h3>Session Payment Records</h3>

                    <div class="panel-row">
                        <span>Current Chat Rate</span>
                        <strong>
                            KES {{ current_rate|floatformat:2 }}
                        </strong>
                    </div>

                    <div class="panel-row">
                        <span>Unpaid Session Chats</span>
                        <strong>{{ unpaid_chats }}</strong>
                    </div>

                    <div class="panel-row">
                        <span>Paid Session Chats</span>
                        <strong>{{ paid_chats }}</strong>
                    </div>

                    <div class="panel-row">
                        <span>Session Records</span>
                        <strong>{{ payment_count }}</strong>
                    </div>

                    <div class="coverage-actions">
                        <a
                            href="{% url 'payments:history' %}"
                            class="button button-primary"
                        >
                            View Session Payment History
                        </a>
                    </div>

                </div>

            </section>

            <section class="section two-column">

                <div class="panel">

                    <h3>Session Status</h3>

                    <div class="panel-row">
                        <span>Reports Awaiting Submission</span>
                        <strong
                            class="status-number {% if awaiting_reports > 0 %}alert{% endif %}"
                        >
                            {{ awaiting_reports }}
                        </strong>
                    </div>

                    <div class="panel-row">
                        <span>Missed Sessions</span>
                        <strong
                            class="status-number {% if missed_sessions > 0 %}danger{% endif %}"
                        >
                            {{ missed_sessions }}
                        </strong>
                    </div>

                    <div class="panel-row">
                        <span>Replacement Requests</span>
                        <strong
                            class="status-number {% if replacement_requests > 0 %}alert{% endif %}"
                        >
                            {{ replacement_requests }}
                        </strong>
                    </div>

                </div>

                <div class="panel">

                    <h3>Quick Actions</h3>

                    <div class="quick-actions">

                        <a
                            href="{% url 'coverage:moderator_coverage' %}"
                            class="quick-action"
                        >
                            <span class="quick-icon">&#128197;</span>
                            My Coverage
                        </a>

                        <a
                            href="{% url 'dashboard:coverage_history' %}"
                            class="quick-action"
                        >
                            <span class="quick-icon">&#128196;</span>
                            Reports
                        </a>

                        <a
                            href="{% url 'payments:history' %}"
                            class="quick-action"
                        >
                            <span class="quick-icon">&#128176;</span>
                            Payments
                        </a>

                        <a
                            href="{% url 'notifications:list' %}"
                            class="quick-action"
                        >
                            <span class="quick-icon">&#128276;</span>
                            Notifications
                            {% if unread_notification_count %}
                                <span class="badge bg-danger ms-1">
                                    {{ unread_notification_count }}
                                </span>
                            {% endif %}
                        </a>

                        <a
                            href="{% url 'dashboard:profile' %}"
                            class="quick-action"
                        >
                            <span class="quick-icon">&#128100;</span>
                            Profile
                        </a>


                        <div class="quick-action quick-contact-action">
                            <span class="quick-icon">&#128172;</span>
                            Contact Management

                            <div class="quick-contact-links">
                                {% if manager_contact and manager_contact.whatsapp_number %}
                                    <a
                                        href="https://wa.me/{{ manager_contact.whatsapp_number }}?text={{ "Hello "|add:manager_contact.user.get_full_name|add:", this is "|add:request.user.get_full_name|add:" from Sansfrontieres. I am reaching out regarding my current coverage assignment and would appreciate your guidance on any matter requiring your attention. Thank you."|urlencode }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="quick-contact-button"
                                    >
                                        Message Manager
                                    </a>
                                {% else %}
                                    <span class="quick-contact-unavailable">
                                        Manager WhatsApp unavailable
                                    </span>
                                {% endif %}

                                {% if director_contact and director_contact.whatsapp_number %}
                                    <a
                                        href="https://wa.me/{{ director_contact.whatsapp_number }}?text={{ "Hello "|add:director_contact.user.get_full_name|add:", this is "|add:request.user.get_full_name|add:" from Sansfrontieres. I am reaching out regarding my current coverage assignment and would appreciate your guidance on any matter requiring your attention. Thank you."|urlencode }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="quick-contact-button"
                                    >
                                        Message Director
                                    </a>
                                {% else %}
                                    <span class="quick-contact-unavailable">
                                        Director WhatsApp unavailable
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>

            </section>

            <section class="section">

                <div class="section-heading">
                    <h2>Recent Session Activity</h2>

                    <a href="{% url 'dashboard:coverage_history' %}">
                        View all reports
                    </a>
                </div>

                <div class="panel">

                    {% if recent_reports %}

                        <ul class="activity-list">

                            {% for session in recent_reports %}

                                <li class="activity-item">

                                    <div>
                                        <div class="activity-player">
                                            Player {{ session.player.player_number }}

                                        </div>

                                        <div class="activity-meta">
                                            {{ session.operating_date|date:"d M Y" }} |
                                            {{ session.get_session_type_display }} |
                                            Completed
                                        </div>
                                    </div>

                                    <div class="activity-chats">
                                        {{ session.end_of_session_report.chats_responded }}
                                        chats
                                    </div>

                                </li>

                            {% endfor %}

                        </ul>

                    {% else %}

                        <div class="empty-state">
                            <strong>No session activity yet</strong>
                            Completed session reports will appear here.
                        </div>

                    {% endif %}

                </div>

            </section>

        </div>
    </main>

</div>

{% else %}

<main class="non-moderator">

{% if request.user.role == "MANAGER" %}

<header class="topbar">
