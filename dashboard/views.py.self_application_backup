        return render(
            request,
            "dashboard/my_shifts.html",
            {
                "coverage_sessions": [],
                "message": (
                    "My Shifts is available to Moderators only."
                ),
            },
        )

    if request.method == "POST":

        session_id = request.POST.get("session_id")

        action = request.POST.get("action")

        session = (
            CoverageSession.objects
            .filter(
                id=session_id,
                moderator=request.user,
            )
            .first()
        )

        if session is None:
            return render(
                request,
                "dashboard/my_shifts.html",
                {
                    "coverage_sessions": (
                        CoverageSession.objects
                        .filter(
                            moderator=request.user,
                        )
                        .select_related(
                            "player",
                            "replacement_moderator",
                        )
                    ),
                    "message": (
                        "The requested coverage session "
                        "could not be found."
                    ),
                },
            )

        try:

            if action == "sign_in":

                activate_assigned_coverage(
                    session=session,
                    moderator=request.user,
                )

            elif action == "request_replacement":

                request_replacement(
                    session=session,
                    moderator=request.user,
                )


            elif action == "respond_continuation":

                form = ContinuationResponseForm(request.POST)

                if not form.is_valid():
                    raise ValueError("Select YES or NO to continue.")

                respond_to_coverage_continuation(
                    session=session,
                    moderator=request.user,
                    response=form.cleaned_data["response"],
                )
        except Exception as exc:

            messages.error(
                request,
                str(exc),
            )

        else:

            if action == "sign_in":

                messages.success(
                    request,
                    (
                        "You have successfully signed in "
                        "to this Player coverage session."
                    ),
                )

            elif action == "request_replacement":

                messages.success(
                    request,
                    (
                        "Replacement requested. Please continue "
                        "covering the Player until the replacement "
                        "is secured."
                    ),
                )


            elif action == "respond_continuation":

                response = request.POST.get("response")

                if response == "YES":
                    messages.success(
                        request,
                        "Continuation confirmed. You will continue covering the same Player for the next coverage period.",
                    )

                elif response == "NO":
                    messages.success(
                        request,
                        "Coverage ended. Submit your End-of-Session Report within 30 minutes.",
                    )
        return redirect(
            "dashboard:my_shifts"
        )

    close_expired_coverage_sessions(
        moment=timezone.localtime(),
    )

    coverage_sessions = (
        CoverageSession.objects
        .select_related(
            "player",
            "replacement_moderator",
        )
        .filter(
            moderator=request.user,
        )
        .order_by(
            "-operating_date",
            "-created_at",
        )
    )

    return render(
        request,
        "dashboard/my_shifts.html",
        {
            "coverage_sessions": coverage_sessions,
        },
    )













